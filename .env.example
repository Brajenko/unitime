# APP_SECRET обязателен (не короче 32 символов), без него сервис не стартует. Добавьте:
#   echo "APP_SECRET=$(openssl rand -hex 32)" >> .env
DATABASE_URL=postgresql+psycopg://slot:slot@postgres:5432/slot
REDIS_URL=redis://redis:6379/0
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback
